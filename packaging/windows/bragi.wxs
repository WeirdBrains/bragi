<!-- Bragi's per-user Windows installer (WiX Toolset 7): bragi.exe in %LOCALAPPDATA%\Programs\Bragi,
     a Start menu shortcut, upgrades in place, no admin rights needed. Built by scripts/dist-windows.ps1
     (wix build -acceptEula wix7 ... -d Source=DIR -d ProductVersion=X.Y.Z -d LicenseRtf=FILE -d Ffmpeg=0|1). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Bragi" Manufacturer="Weird Brains LLC" Version="$(var.ProductVersion)"
           UpgradeCode="a9cfacdc-099f-4bfa-88db-ff4b997e9e6b" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer Bragi is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="BragiIcon" SourceFile="$(var.Source)\bragi.ico" />
    <Property Id="ARPPRODUCTICON" Value="BragiIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://bragi.weirdbrains.com" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Bragi">
          <!-- Per-user components key on an HKCU value (ICE38), remove their folders (ICE64) and so need
               fixed GUIDs (WIX0230). Never change a GUID once released. -->
          <Component Id="BragiExe" Guid="94f2a385-ee40-473b-adce-16ddfbcca3ab">
            <File Id="BragiExeFile" Source="$(var.Source)\bragi.exe" />
            <RegistryValue Root="HKCU" Key="Software\Weird Brains\Bragi" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
            <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
          </Component>
          <!-- bragi.exe is the terminal app too (`bragi desktop` opens the window); bragi-tui.exe is its old name, kept for one release. The install folder goes on the user's PATH so both run in any terminal. -->
          <Component Id="BragiTuiExe" Guid="5b0d6f7e-3c1a-4e8b-9f2d-7a6c4e1b8d35">
            <File Id="BragiTuiExeFile" Source="$(var.Source)\bragi-tui.exe" />
            <Environment Id="BragiTuiPath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="no" />
            <RegistryValue Root="HKCU" Key="Software\Weird Brains\Bragi" Name="Tui" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="BragiLicense" Guid="42421fb6-c380-4f97-8bda-f3bd0c45c641">
            <File Id="BragiLicenseFile" Source="$(var.Source)\LICENSE.txt" />
            <RegistryValue Root="HKCU" Key="Software\Weird Brains\Bragi" Name="License" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="BragiNotices" Guid="0b6f2d4e-8a51-4c7e-9d3b-2e7f1a6c5d94">
            <File Id="BragiNoticesFile" Source="$(var.Source)\THIRD_PARTY_NOTICES.md" />
            <RegistryValue Root="HKCU" Key="Software\Weird Brains\Bragi" Name="Notices" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <?if $(var.Ffmpeg) = 1 ?>
          <!-- The LGPL ffmpeg and ffprobe from scripts/build-ffmpeg.sh, beside bragi.exe, with their notices. -->
          <Component Id="BragiFfmpeg" Guid="6d3a9c1f-2b8e-4f57-a0c4-9e1d7b3f5a28">
            <File Id="FfmpegExe" Source="$(var.Source)\ffmpeg.exe" />
            <File Id="FfprobeExe" Source="$(var.Source)\ffprobe.exe" />
            <File Id="FfmpegLicense" Source="$(var.Source)\FFMPEG-LICENSE.md" />
            <File Id="FfmpegConfig" Source="$(var.Source)\FFMPEG-CONFIG.txt" />
            <File Id="FfmpegSource" Source="$(var.Source)\FFMPEG-SOURCE.txt" />
            <RegistryValue Root="HKCU" Key="Software\Weird Brains\Bragi" Name="Ffmpeg" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <?endif?>
          <Component Id="BragiIconFile" Guid="4629b1b3-c281-4086-aac6-4ee67c4ae11a">
            <File Id="BragiIcoFile" Source="$(var.Source)\bragi.ico" />
            <RegistryValue Root="HKCU" Key="Software\Weird Brains\Bragi" Name="Icon" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="BragiShortcut" Guid="8f4343d4-7b19-44e8-bc95-0a2fd29571e2">
        <Shortcut Id="BragiStartMenu" Name="Bragi" Description="Chat with your private AI cloud"
                  Target="[INSTALLFOLDER]bragi.exe" Arguments="desktop" WorkingDirectory="INSTALLFOLDER" Icon="BragiIcon" />
        <RegistryValue Root="HKCU" Key="Software\Weird Brains\Bragi" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Bragi">
      <ComponentRef Id="BragiExe" />
      <ComponentRef Id="BragiTuiExe" />
      <ComponentRef Id="BragiLicense" />
      <ComponentRef Id="BragiIconFile" />
      <ComponentRef Id="BragiNotices" />
      <?if $(var.Ffmpeg) = 1 ?>
      <ComponentRef Id="BragiFfmpeg" />
      <?endif?>
      <ComponentRef Id="BragiShortcut" />
    </Feature>
  </Package>
</Wix>
