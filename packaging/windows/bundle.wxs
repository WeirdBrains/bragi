<!-- Bragi's setup .exe (a WiX 7 Burn bundle) around the per-user MSI (bragi.wxs). Built by
     scripts/dist-windows.ps1 with -ext WixToolset.BootstrapperApplications.wixext. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Bragi" Manufacturer="Weird Brains LLC" Version="$(var.ProductVersion)"
          UpgradeCode="b515956e-9951-4ed4-8b77-5fd206a21efe" IconSourceFile="$(var.Source)\bragi.ico"
          AboutUrl="https://bragi.weirdbrains.com">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseFile="$(var.LicenseRtf)" Theme="rtfLicense" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(var.Msi)" />
    </Chain>
  </Bundle>
</Wix>
